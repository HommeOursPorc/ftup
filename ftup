#!/bin/sh
export PATH=/bin:/usr/bin:/sbin:/usr/sbin:/home/root:
USERAGENT="Mozilla/5.0 (X11; Linux x86_64; rv:10.0) Gecko/20100101 Firefox/109.0"
alias yget="/usr/bin/wget -T 15 -U \"$USERAGENT\" --header \"Cache-Control: no-cache\""
#. nvram_ops # for future use
NG() { nvram get "$1" ; } # for backward compatibility
trap ctrl_c SIGINT

# FreshTomato Upgrade Script -- HommeOursPorc 2024/04
# Last update == 2025-04-28
ver="v0.50"

help() {
echo -e "FreshTomato Upgrade Script $ver

Usage: ftup [options] [firmware path or URL]

Default is dirty upgrade (NVRAM untouched) unless '-c' or '-r' is specified.

Single option:
  --changelog      Print latest FreshTomato changelog.
  --check          Print latest FreshTomato version number.
  --erase-nvram    Erase all data in NVRAM memory (thorough).
  --id             Identify device.
  --list-firmware  Experimental: List available firmware.
                   Default: Latest version.
                   Optional: Specify version to list,
                   e.g. --list-firmware 2025.2

Options:
  -a               Experimental: Auto upgrade to the latest firmware.
  -c               Clean upgrade (no settings restoration).
  -d <path>        Overrides default download directory (/tmp/ftupwd/).
  -f               Force 'unzip on the fly' download mode.
                   This is for devices with low RAM that can't hold
                   both the zip and firmware files in RAM simultaneously).
  -g (ver./build)  Experimental: Get (download) chosen firmware.
                   Default (no args): Get latest version and same
                   build as the one currently running.
                   Optional: ver. (version), e.g. 2024.4
                   Optional: build, e.g. Mini, Max, VPN, AIO, etc.
                   e.g. -g 2025.2/AIO
  -n               Use wget '--no-check-certificate'
                   (you can try this if wget fail to download the firmware).
  -o               Only download firmware (no installation).
  -r               Restore settings after upgrade (implies '-c'),
                   PlainText Backup script by @rs232 is required
                   which is available on the 'linksysinfo.org' forum.
  -y               Automatic 'YES' to prompts. USE WITH CAUTION!
  -z               Force zip download in tmpfs.

Infos:
 - Single option are meant to be run without any other arguments.
 - URL must begin with \"http(s)://\".
 - Supported format is zip, trx, bin and chk.
 - Experimental features can be inaccurate, use at your own risk.

WARNING:
   This script comes with no guarantee.
   This script, especially with option '-y', could be dangerous!
   Make sure you are using the right firmware before proceeding!
   
I'm NOT responsible for any bricked devices. Use at your own risks.
   
USE WITH CAUTION!\n"
}

error() {
# $1 = ERROR No
e=3
m="" # message
case $1 in
1)  m="Unknown argument.";;
2)  m="Too many arguments.";;
3)  m="Firmware path or URL is missing.";;
4)  m="No USB device found. Settings restoration is not possible.";;
5)  m="nvram_backup is missing. Settings restoration is not possible.";;
6)  m="Firmware format not supported.";;
7)  m="Out of memory, not enough RAM.";;
8)  m="Unable to download firmware.";;
9)  m="Firmware doesn't exist or file is empty.";;
10) m="ZIP archive is corrupted.";;
11) m="Can't unzip archive, it's either corrupted or not enough RAM.";;
12) m="ZIP archive countain zero or more than one firmware.";;
13) m="Upgrading firmware with JFFS enabled is not possible. Optionally you can enable 'Unmount JFFS during upgrade' in the webUI in 'Administration > Admin Access'";;
14) m="Backup is missing. Settings restoration is not possible.";;
15) e=5; m="Operation cancelled.";;
16) m="Can't fetch newest version number from freshtomato.org.";;
17) m="Destination directory doesn't exist.";;
18) m="Can't download zip file if source is not a zip file.";;
19) m="Can't download zip file if there's no file to download.";;
20) m="MD5 sum did NOT match! Impossible to verify downloaded firmware file integrity!";;
21) m="Firmware URL is missing.";;
22) m="Firmware informations doesn't match the router informations. Make sure you are using the right firmware for your device or try to upgrade without option '-y'.";;
23) m="Unable to fetch changelog data from GitHub.";;
24) m="Cannot use JFFS partition for upgrades. JFFS cannot get unmounted while still working from the '/jffs' directory.";;
25) m="Invalid version number. Version must be e.g. 2025.2";;
26) m="Invalid build type. Build must be e.g. Mini, Max, VPN, AIO, etc.";;
27) m="Unable to fetch firmware list.";;
28) m="No firmware match.";;
29) m="Router identification not accurate enough.";;
esac
ilog $e "$m"
kill $(jobs -p) &>/dev/null
rm -f ${WORKDIR}/*
exit $1
}

ilog() {
# $1 = logger Priority (logger -p)
# $2 = message to log
case $1 in
    7) e="DEBUG" ;;
    6) e="INFO" ;;
    5) e="NOTICE" ;;
    4) e="WARNING" ;;
    3) e="ERROR" ;;
esac
logger -p $1 -t $(basename "$0")[$$] "$2"
[ $1 -le 4 ] && echo -e "\n$e: $2\n" || echo "$2"
}

ctrl_c() {
kill $(jobs -p) &>/dev/null
echo; error 15
}

wait_loop() {
# $1 = wait time in seconds
# $2 = msg to print
c=$1
while [ $c -gt 0 ]; do
echo -ne "$2 $c\033[0K\r"
sleep 1
: $((c--))
done
}

id() {
MATCH=""
TARGETS="/tmp/targets_${CPU}.csv"
yget -q --no-check-certificate -O "$TARGETS" "https://github.com/HommeOursPorc/ftup/raw/refs/heads/main/targets_${CPU}.csv"
[ -s "$TARGETS" ] && {
    ACCURACY=25
    [ $(grep -wc "$FULLMODEL" "$TARGETS") -eq 1 ] && { ACCURACY=50 ; MATCH="$(grep -w "$FULLMODEL" "$TARGETS" | awk -F',' '{print $1}')" ; }
}
rm -f "$TARGETS"
echo "$FULLMODEL" | grep -qi "Cisco Linksys" && MAKE="Cisco Linksys" || MAKE="$(echo "$FULLMODEL" | awk '{print $1}')"
TMODEL="$(echo "$FULLMODEL" | awk '{if(NF>=3){{print $(NF-1)"_"$NF}}else{{print $NF}}}' | tr -d "/")"
FIX="$(NG t_fix1)"
ID="$(NG odmpid)"
[ "$FIX" == "$TMODEL" ] && MODEL="$FIX" || { [ "$ID" != "" ] && MODEL="$ID" || MODEL="$FIX" ; }
[ "$MATCH" != "" ] && { [ "$MATCH" == "$MODEL" ] && ACCURACY=100 || MODEL="$MATCH" ; }
SDK="$(echo "$OSVER" | awk '{ for(i=1; i<=NF; i++) { if(match($i, /^K+/)) { print $i; break; } } }')" # eg K26ARM
[ "$CPU" == "mips" ] && {
    MIPSREV="$(echo "$SDK" | cut -d "_" -f1 | sed "s/K26//i")"
    SDK="$(echo "$SDK" | cut -d "_" -f2)"
    NVRAM="$(nvram show | grep "entries,.*bytes" | awk '{print ($3+$6)/1024}')K"
} || {
    NVRAM="$(nvram show 2>&1 >/dev/null | tr -d "()" | awk '{print ($2+$4)/1024}')K"
}
case "$SDK" in
    RTAC) SDKFULL="K26RT-AC";;
    RTN ) SDKFULL="K26RT-N";;
    RT  ) SDKFULL="K26";;
    *   ) SDKFULL="$SDK";;
esac
VAR="$(echo "$OSVER" | awk '{print $NF}')" # eg VPN-64K
}

id_show() {
id
echo "
$FULLMODEL
FreshTomato $OSVER

       MAKE = $MAKE
      MODEL = $MODEL
        CPU = $([ "$MIPSREV" != "" ] && echo "$MIPSREV" || echo "ARM")
        SDK = $SDKFULL    $([ $USB -eq 1 ] && printf "\n        USB = YES")
      NVRAM = $NVRAM
      BUILD = $VAR
    VERSION = $CURVER

MODEL Accuracy = $(
    case "$ACCURACY" in
        100) echo "HIGH -- Matched online";;
         50) echo "MEDIUM -- Partial match";;
         25) echo "LOW -- No match (possible \"unnamed\" firmware)";;
          0) echo "POOR -- Best effort";;
    esac
)

Please report any incorrect results at
https://www.linksysinfo.org/index.php?threads/freshtomato-upgrade-script-v0-11.78326/
"
}

fw_list() {
# $1 == version/build
VER=""
BUILD=""
SED="\(BTgui-VPN\|BT-VPN\|BT\|Big-VPN\|Nocat-VPN\|Mega-VPN\|IPv6-VPN\|AIO_Lite\|AIO\|Custom\|MiniIPv6\|MiniVPN2\|MiniVPN\|Mini\|Max\|VPN\)"
GREP=$(echo "$SED" | tr -d "\\()" | tr "|" "\n")
URL="https://freshtomato.org/downloads/freshtomato-${CPU}"
NODE=""
TMPLIST="/tmp/tmplist.txt"
FWLIST="/tmp/fwlist.txt"
id
[ $ACCURACY -eq 0 ] && error 29
[ $ACCURACY -eq 25 ] && [ "$CPU" == "arm" -o "$SDK" == "RTAC" ] && error 29
[ $# -eq 1 ] && {
    [ $(echo "$1" | grep -c '/') -eq 1 ] && {
        VER="$(echo "$1" | awk -F'/' '{print $1}')"
        BUILD="$(echo "$1" | awk -F'/' '{print $2}')"
    } || {
        [ $(echo "$1" | grep -cE '20[0-9][0-9]\.[0-9]($|[0-9]$)') -eq 1 ] && VER="$1" || BUILD="$1"
    }
}
[ "$VER" == "" ] && { check_update -q ; VER="$LATESTVER" ; }
[ $(echo "$VER" | grep -cE '20[0-9][0-9]\.[0-9]($|[0-9]$)') -ne 1 ] && error 25
YEAR="${VER%.*}"
[ $LIST -eq 1 ] && {
    BUILD="$(echo "$VAR" | sed "s/$SED/\.\*/i")"
} || {
    [ "$BUILD" == "" ] && {
        BUILD="$VAR"
    } || {
        [ $(printf "$GREP" | grep -cix "$BUILD") -eq 0 ] && error 26
        BUILD="$(echo "$VAR" | sed "s/$SED/$BUILD/i")"
    }
}
URL="${URL}/${YEAR}/${VER}"
[ "$CPU" == "arm" ] && {
    NODE="$(basename "$URL")"
} || {
    URL="${URL}/${SDKFULL}"
    NODE="$(basename "$URL")"
}
yget -q --no-check-certificate -O- "$URL" | grep "data-sort=" | sed "s/.*\(\/$NODE\/\)//g;s/\".*//g" | tr -d "/" | grep "^freshtomato" | awk -v var="$URL" '{print var"/"$0}' > "$TMPLIST"
[ "$SDK" == "RTN" ] && {
    URL="${URL}/Asus%20RT-Nxx%20%26%20CO"
    NODE="$(basename "$URL")"
    yget -q --no-check-certificate -O- "$URL" | grep "data-sort=" | sed "s/.*\(\/$NODE\/\)//g;s/\".*//g" | tr -d "/" | grep "^freshtomato" | awk -v var="$URL" '{print var"/"$0}' >> "$TMPLIST"
}
[ ! -s "$TMPLIST" ] && error 27
[ $ACCURACY -ge 50 ] && {
    # Named
    grep -qi "$MODEL.*$BUILD" "$TMPLIST" || error 28
    grep -wi "$MODEL.*$BUILD" "$TMPLIST" > "$FWLIST"
} || {
    # Unnamed
    PATTERN="freshtomato-K26"
    SPECIAL=0
    if [ "$MIPSREV" == "MIPSR1" -a $USB -eq 0 ]; then
        PATTERN="${PATTERN}MIPSR1_$SDK"
    elif [ "$MIPSREV" == "MIPSR1" -a $USB -eq 1 ]; then
        PATTERN="${PATTERN}MIPSR1_$SDK-USB"
    elif [ $(echo "$VAR" | grep -ci "K$") -eq 1 ]; then
        PATTERN="${PATTERN}MIPSR2_$SDK-USB"
        SPECIAL=1
    elif [ "$MIPSREV" == "MIPSR2" -a $USB -eq 0 ]; then
        PATTERN="${PATTERN}MIPSR2_$SDK-NVRAM$NVRAM"
    elif [ "$MIPSREV" == "MIPSR2" -a $USB -eq 1 ]; then
        PATTERN="${PATTERN}MIPSR2_$SDK-USB-NVRAM$NVRAM"
    fi
    PATTERN="$PATTERN-$VER-$BUILD"
    [ $SPECIAL -eq 0 ] && {
        grep -wi "$PATTERN" "$TMPLIST" > "$FWLIST"
    } || {
        sed "s/\.zip//g" "$TMPLIST" | grep "K$" | grep -wi "$PATTERN" > "$FWLIST"
    }
}
rm -f "$TMPLIST"
[ ! -s "$FWLIST" ] && error 28
[ $LIST -eq 0 -a $(wc -l "$FWLIST" | awk '{print $1}') -ne 1 ] && error 28 || return 0
}

fw_get() {
# $1 == version/build
[ $# -eq 1 ] && ARGS="$1" || ARGS=""
FWLIST="/tmp/fwlist.txt"
[ $AUTOYES -eq 1 ] && { echo "Full auto upgrades are currently disabled until this feature is proven to be working perfectly." ; error 15 ; }
[ $AUTOUP -eq 1 ] && {
    check_update -q
    [ $CANUP -eq 0 ] && { printf "\nNo upgrade available.\n\n" ; exit 0 ; } || ARGS="$LATESTVER"
}
echo -e "\n
This feature is experimental. Use with caution.
Double check that it output the right firmware before upgrading.
I am not responsible for any bricked device.
"
[ "$ARGS" != "" ] && fw_list "$ARGS" || fw_list
FWURL="$(cat "$FWLIST")"
get_filename
echo -e "USE WITH CAUTION!

$FULLMODEL
FreshTomato $OSVER
$([ $CANUP -eq 1 ] && printf "%s" "\nNew version $LATESTVER is available.\n\n")
Upgrade with this firmware?
$FWURL
"
#[ $AUTOYES -eq 1 ] && {
