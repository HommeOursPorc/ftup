changelog() {
echo "Getting changelog from https://github.com/FreshTomato-Project ..."
yget -q --no-check-certificate -O /tmp/ftup_cl.txt "https://github.com/FreshTomato-Project/freshtomato-${CPU}/raw/refs/heads/${CPU}-master/CHANGELOG"
[ $? -ne 0 ] && error 23
echo -e "YOUR VERSION = $CURVER\nTO QUIT PRESS 'Q'\n\n$(cat /tmp/ftup_cl.txt)" | less
rm -f /tmp/ftup_cl.txt
}

check_update() {
# $1 == Quiet/Silent
SILENT=0
[ $# -eq 1 ] && { [ "$1" == "-q" ] && SILENT=1 ; }
LATESTVER="$(yget -q --no-check-certificate -O- "http://freshtomato.org/version.txt")"
[ "$LATESTVER" == "" ] && error 16
MAJ="${CURVER%.*}"
MIN="${CURVER##*.}"
LMAJ="${LATESTVER%.*}"
LMIN="${LATESTVER##*.}"
UP=0
[ $SILENT -eq 0 ] && echo "Current version = $CURVER
Latest  version = $LATESTVER"
[ $LMAJ -gt $MAJ ] && UP=1
[ $LMAJ -eq $MAJ -a $LMIN -gt $MIN ] && UP=1
[ $UP -eq 1 ] && { CANUP=1 ; [ $SILENT -eq 0 ] && echo "UPDATE AVAILABLE!" ; }
}

enough_memory() {
# $1 = FWSIZE
# enoughmem=0 --> no  (not enough)
# enoughmem=1 --> yes (proceed)
AVAIL=$(awk '/MemFree/ {print $2}' /proc/meminfo)
[ $1 -ge $AVAIL ] && echo 0 || echo 1
}

get_filename() {
filename="$(basename "$FWURL")"
extension="${filename##*.}"
[ "$extension" != "zip" -a "$extension" != "trx" -a "$extension" != "bin" -a "$extension" != "chk" ] && error 6
[ "$extension" == "zip" ] && ISZIP=1
}

download() {
[ "$CPU" == "mips" ] && QUIET="-q" || QUIET=""
[ "$DLDIR" != "" ] && DESTDIR="$DLDIR" || DESTDIR="$WORKDIR"
[ "$(df -P "$DESTDIR" | tail -n1 | awk '{print $1}')" == "tmpfs" ] && TMPFS=1
yget -qS --spider $NOCHECK "$FWURL" 2>"${WORKDIR}/yget.out"
[ $? -eq 0 -a $(grep -ci "content-length" "${WORKDIR}/yget.out") -eq 1 ] && FWSIZE=$((($(awk 'tolower($0) ~ /content-length/ {print $2}' "${WORKDIR}/yget.out")/1024)*3))
rm -f "${WORKDIR}/yget.out"
[ $ISZIP -eq 1 -a $TMPFS -eq 1 -a $FORCEZIP -eq 0 -a $FORCEFLY -eq 0 -a $FWSIZE -gt 0 ] && [ $(enough_memory $FWSIZE) -eq 1 ] && FORCEZIP=1
echo "Starting download..."
{
c=0; until [ "$(pidof wget)" ];do c=$((c+1)); [ $c -le 21 ] && usleep 500000 || break ; done ; c=0
while [ "$(pidof wget)" ]; do
    c=$((c+1))
    sleep 1
    [ "$CPU" == "mips" -a $c -gt 1 ] && printf "Downloading... %02d:%02d:%02d\r" $((c/3600)) $(((c%3600)/60)) $((c%60))
done
printf "\rDownloaded in  %02d:%02d:%02d\n" $((c/3600)) $(((c%3600)/60)) $((c%60))
} &
[ $ISZIP -eq 1 -a $TMPFS -eq 1 -a $FORCEZIP -eq 0 ] || [ $FORCEFLY -eq 1 ] && {
    echo "Download mode: SLOW -- unzip on the fly"
    echo "Warning: This mode is very SLOW! Please be patient."
    rm -f "${WORKDIR}/pipe1" "${WORKDIR}/pipe2" ; mkfifo "${WORKDIR}/pipe1" "${WORKDIR}/pipe2"
    md5sum "${WORKDIR}/pipe1" > "${WORKDIR}/${filename}.md5" &
    unzip -l "${WORKDIR}/pipe2" > "${WORKDIR}/zip.list" &
    yget $QUIET $NOCHECK -O- "$FWURL" | tee "${WORKDIR}/pipe1" | tee "${WORKDIR}/pipe2" | unzip -o - "*.trx" "*.bin" "*.chk" -d "$DESTDIR" || error 8
    wait $(pidof wget) $(pidof unzip)
    [ $(grep -Ec "\.trx|\.bin|\.chk" "${WORKDIR}/zip.list") -eq 1 ] && fwname="$(awk '/\.trx|\.bin|\.chk/ {print $4}' "${WORKDIR}/zip.list")" || error 12
    DESTMD5SUM="$(awk '{print $1}' "${WORKDIR}/${filename}.md5")"
    ISZIP=0
    rm -f "${WORKDIR}/pipe1"  "${WORKDIR}/pipe2" "${WORKDIR}/${filename}.md5" "${WORKDIR}/zip.list"
    FWPATH="${DESTDIR}/$fwname"                                 
} || {
    echo "Download mode: FAST -- direct download"
    FWPATH="${DESTDIR}/$filename"
    yget $QUIET $NOCHECK -O "$FWPATH" "$FWURL" || error 8
    [ $OFFICIAL -eq 1 -a -s "$FWPATH" ] && DESTMD5SUM="$(md5sum "$FWPATH" | awk '{print $1}')"
}
sleep 1
[ ! -s "$FWPATH" ] && error 9
[ $OFFICIAL -eq 1 ] && {
    echo "Verifying MD5 SUM..."
    md5path="${FWURL%/*}/MD5SUM"
    SRCMD5SUM="$(yget -q $NOCHECK -O- "$md5path" | grep "$filename" | awk '{print $1}')"
    ERROR=0
    [ "$SRCMD5SUM" != "" ] && {
        echo "$SRCMD5SUM" > "${DESTDIR}/${filename}.md5"
        echo "Source   MD5 sum = $SRCMD5SUM"
        echo "Download MD5 sum = $DESTMD5SUM"
        [ "$SRCMD5SUM" == "$DESTMD5SUM" ] && echo -e "MD5 Match!\n" || ERROR=1
    } || {
        ERROR=1
    }
    [ $ERROR -eq 1 ] && { rm -f "$FWPATH" "${DESTDIR}/${filename}.md5" ; error 20 ; }
}
echo "saved: $FWPATH"
[ $ONLY -eq 1 ] && printf "Download completed.\n\n"
}

prep_file() {
[ "$FWPATH" == "" ] && {
    FWPATH="$FWURL"
    [ "$(df -P "$FWPATH" | tail -n1 | awk '{print $1}')" == "tmpfs" ] && TMPFS=1
}
[ $TMPFS -eq 0 -a $ISZIP -eq 0 ] && {
    cp -f "$FWPATH" "$WORKDIR" || error 7
    FWPATH="${WORKDIR}/${filename}"
}
[ $ISZIP -eq 1 ] && {
    unzip -t "$FWPATH" || error 10
    [ $(unzip -l "$FWPATH" | grep -Ec "\.trx|\.bin|\.chk") -eq 1 ] && fwname="$(unzip -l "$FWPATH" | grep -E "\.trx|\.bin|\.chk" | awk '{print $4}')" || error 12
    FWSIZE=$(($(unzip -l "$FWPATH" | grep -E "\.trx|\.bin|\.chk" | awk '{print $1}')/1024))
    [ $TMPFS -eq 1 ] && FWSIZE=$((${FWSIZE}+$(du "$FWPATH" | awk '{print $1}')))
    [ $(enough_memory $FWSIZE) -eq 0 ] && error 7
    unzip -o "$FWPATH" "$fwname" -d "$WORKDIR" || error 11
    [ $TMPFS -eq 1 ] && rm -f "$FWPATH"
    FWPATH="${WORKDIR}/$fwname"
    [ ! -s "$FWPATH" ] && error 9
}

# check if right firmware if possible
[ "$MODEL" == "" ] && id
WARN=""
fwname="$(basename "$FWPATH")"
[ "$CPU" == "arm" -a "$MODEL" != "R1D" ] && {
    [ "$(tail -n1 "$FWPATH" | strings | tail -n1)" != "$MODEL" ] && WARN="WARNING: Model name $MODEL NOT found inside the firmware file footer.\n"
}
[ $(echo "$fwname" | grep -ci "$SDK") -ne 1 ] && WARN="${WARN}WARNING: Router SDK (${SDK}) doesn't match the one stated in the firmware name.\n"
nvsize="$(echo "$fwname" | grep -Eo "(|[1-9])[1-9][1-9]K")"
[ "$nvsize" != "$NVRAM" ] && WARN="${WARN}WARNING: NVRAM size (${NVRAM}) doesn't match with the size stated in the firmware name (${nvsize}).\n"
[ "$CPU" == "mips" -a $(echo "$fwname" | grep -ci "$MIPSREV") -ne 1 ] && WARN="${WARN}WARNING: MIPS version (${MIPSREV}) doesn't match with the one stated in the firmware name.\n"
[ "$CPU" == "arm" -a $(echo "$fwname" | grep -ci "ARM") -ne 1 ] && WARN="${WARN}WARNING: CPU version (ARM) doesn't match with the one stated in the firmware name.\n"
[ "$WARN" != "" ] && {
    printf "\n$WARN"
    [ $AUTOYES -eq 1 ] && error 22
    ilog 4 "Some information doesn't match, make sure you are using the right firmware before proceeding!!"
    printf "\nContinue anyway? $MSG"
    read ANSWER ; echo
    [ "$ANSWER" != "yes" ] && error 15
}
}

restore() {
printf "Creating backup..."
$NVBACKUP usbrestore all
[ -s "$AUTORUN" ] && printf " Done\n" || error 14
ilog 5 "Backup created successfully: $AUTORUN"
}

handle_jffs() {
JFFS=1
pwd | grep -q "^/jffs" && error 24
pwd -P | grep -q "^/jffs" && error 24
dirname "$0" | grep -q "^/jffs" && error 24
echo "$DLDIR" | grep -q "^/jffs" && error 24
echo "$FWURL" | grep -q "^/jffs" && error 24
echo "
WARNING: JFFS is enabled.
         Make sure you have a backup of its content as
         it is not guaranteed the content of JFFS
         will be preserved after a firmware upgrade."
[ $(NG jffs2_auto_unmount) -eq 1 ] && {
    printf "         Auto unmount JFFS during upgrade is enabled.\n\n"
    printf "JFFS will be stopped and unmounted\n"
    printf "\nTo cancel press CTRL+C\n\n"
    wait_loop 7 "Continuing in"
} || {
    [ $AUTOYES -eq 1 ] && {
        error 13
    } || {
        printf "\nUnmount JFFS to continue the upgrade?\n\n"
        printf "$MSG"
        read ANSWER ; echo
        [ "$ANSWER" != "yes" ] && error 15
    }
}
    kill_jffs() {
        kill -9 $(ps | grep -v "jffs.*gcd" | grep -v "ftup" | grep "[/]jffs" | awk '{print $1}') &>/dev/null
        which lsof &>/dev/null && {
            kill -9 $(lsof | grep -v "ftup" | grep "/jffs" | awk '{print $1}') &>/dev/null
        }
    }
printf "Stopping JFFS... "
sync && sleep 2
kill_jffs
service jffs stop &>/dev/null
sleep 1
c=0
while ps | grep -q "[j]ffs.*gcd"; do
    [ $c -eq 5 ] && { printf "Unable to unmount JFFS\n" ; error 13 ; }
    kill_jffs
    umount -fl /jffs &>/dev/null
    c=$(($c+1))
    sleep 1
done
lsmod | grep -q jffs && modprobe -r jffs jffs2 &>/dev/null
lsmod | grep -q jffs && { printf "Unable to unmount JFFS\n" ; error 13 ; }
printf "Done\n"
}

prepare_upgrade() {
# Prepare firmware flashing
sync
c=10; while [ "$(nvram get action_service)" -a $c -gt 0 ];do c=$((c-1));echo -ne "Please wait... $c\033[0K\r";sleep 1;done
nvram set action_service="upgrade-start"
sleep 2
kill -s SIGUSR1 1
c=60; while [ "$(nvram get action_service)" -a $c -gt 0 ];do c=$((c-1));echo -ne "Stopping services... $c\033[0K\r";sleep 1;done; printf "Stopping services... Done\n"
}

upgrade() {
# Write firmware file
[ -e "${WORKDIR}/ftup.out" ] && rm -f ${WORKDIR}/ftup.out
[ "$CPU" == "arm" ] && {
    nohup mtd-write2 ${FWPATH} linux > ${WORKDIR}/ftup.out 2>/dev/null &
    MTD="mtd-write2"
} || {
    nohup mtd-write -w -i ${FWPATH} -d linux > ${WORKDIR}/ftup.out 2>/dev/null &
    MTD="mtd-write"
}
c=0; until [ "$(pidof "$MTD")" ];do c=$((c+1)); [ $c -le 21 ] && { echo -ne "Please wait... $c\033[0K\r"; usleep 500000; } || break ; done
c=0; while [ "$(pidof "$MTD")" ];do c=$((c+1)); echo -ne "Writing firmware... $c\033[0K\r";sleep 1;done; printf "Writing firmware... Done\n"
sleep 2

# Check if flash successful
[ ! -s "${WORKDIR}/ftup.out" ] && {
    ilog 3 "Writing of ${fwname} unsuccessful!!"
    FAIL=1
    [ $RESTORE -eq 1 ] && {
        NOMORE="restore.$(date '+%Y%m%d_%H%M%S')"
        mv -f "$AUTORUN" "$(dirname "$AUTORUN")/$NOMORE"
        ilog 6 "Auto settings restoration cancelled, restore.autorun was renamed $NOMORE"
    }
    echo -e "\nSomething went wrong. The router is NOT upgraded. The router will reboot.\n"
    echo -e "To cancel the reboot and retry the upgrade manually press 'Ctrl+C'\n"
    wait_loop 10 "Rebooting in"
    rboot
}
echo "mtd-write: $(cat ${WORKDIR}/ftup.out | sort -u)"
rm -f ${WORKDIR}/ftup.out
ilog 6 "Successfully flashed $fwname"
}

erase_nvram() {
ilog 6 "Erasing nvram"
[ "$CPU" == "arm" ] && mtd-erase2 nvram || mtd-erase -d nvram
sleep 2
}

rboot() {
[ $RESTORE -eq 1 -a $FAIL -eq 0 ] && ilog 6 "Your router will reboot twice to restore its settings. Please be patient."
sync
/sbin/reboot && kill -9 $PPID
exit
}


# Global Variables
WORKDIR="/tmp/ftupwd"
MSG="To continue type [yes], to cancel type [n]: "
OPTIONS=""
MODE=""
FAIL=0
AUTOUP=0
GETFW=0
SETFW=0
GETFWARG=""
REMOTE=0
OFFICIAL=0
FORCEZIP=0
FORCEFLY=0
DLDIR=""
SETDIR=0
NOCHECK=""
ONLY=0
ERASE=0
AUTOYES=0
RESTORE=0
NVBACKUP=""
AUTORUN=""
FWPATH=""
FWURL=""
FWSIZE=0
filename=""
extension=""
fwname=""
ISZIP=0
TMPFS=0
[ "$(uname -m)" == "mips" ] && CPU="mips" || CPU="arm"
MIPSREV=""
OSVER="$(NG os_version)"
CURVER="$(echo "$OSVER" | awk '{print $1}')" # eg 2023.3
LATESTVER=""
CANUP=0
FULLMODEL="$(NG t_model_name)"
MAKE=""
MODEL=""
ACCURACY=0
echo "$OSVER" | grep -qi usb && USB=1 || USB=0
SDK=""
SDKFULL=""
VAR=""
NVRAM=""
JFFS=0
LIST=0


# Check and set arguments
[ $# -eq 0 ] && { help; exit 0; }
[ $# -eq 1 ] && { [ "$1" == "help" -o "$1" == "-h" -o "$1" == "--help" ] && { help; exit 0; } }
[ $# -eq 1 ] && { printf "%s" "$1" | grep -q "^--" && {
    case $1 in
        --changelog)      changelog ; exit 0 ;;
        --check)          check_update ; exit 0 ;;
        --erase-nvram)    ERASE=1 ;;
        --id)             id_show ; exit 0 ;;
        --list-firmware)  fw_show ; exit 0 ;;
    esac
    }
}
[ $# -eq 2 -a "$1" == "--list-firmware" ] && { fw_show "$2" ; exit 0 ; }
[ $ERASE -eq 0 ] && {
for a in "$@"; do
    [ $SETFW -eq 1 ] && { SETFW=0 ; printf "%s" "$a" | grep -qv "^-" && { GETFWARG="$a" ; continue ; } }
    printf "%s" "$a" | grep -q "^--" && error 1
    printf "%s" "$a" | grep -q "^-" && {
        printf "%s" "$a" | grep -qE "g.*d|d.*g" && error 2
        a="$(printf "%s" "$a" | cut -c 2-)"
        [ "$a" == "" ] && error 1
        OPTIONS="$(printf "%s" "$a" | grep -o . )"
        for o in $OPTIONS; do
            case $o in
                a) [ $AUTOUP     -eq 0 ] && AUTOUP=1     || error 2 ;;
                c) [ "$MODE"     == "" ] && MODE="clean" || error 2 ;;
                d) [ "$DLDIR"    == "" ] && { DLDIR=1 ; SETDIR=1 ; }         || error 2 ;;
                f) [ $FORCEFLY   -eq 0 ] && FORCEFLY=1   || error 2 ;;
                g) [ $GETFW      -eq 0 ] && { GETFW=1 ; SETFW=1  ; }         || error 2 ;;
                n) [ "$NOCHECK"  == "" ] && NOCHECK="--no-check-certificate" || error 2 ;;
                o) [ $ONLY       -eq 0 ] && ONLY=1       || error 2 ;;
                r) [ $RESTORE    -eq 0 ] && RESTORE=1    || error 2 ;;
                y) [ $AUTOYES    -eq 0 ] && AUTOYES=1    || error 2 ;;
                z) [ $FORCEZIP   -eq 0 ] && FORCEZIP=1   || error 2 ;;
                *) error 1 ;;
            esac
        done
    } || {
        [ $SETDIR -eq 1 ] && { [ -d "$a" ] && { DLDIR="$a" ; SETDIR=0 ; continue ; } || error 17 ; }
        [ "$FWURL" == "" ] && {
            printf "%s" "$a" | grep -qi "^http" && REMOTE=1
            printf "%s" "$a" | grep -Eqi "^http(|s)://(|www.)freshtomato.org" && OFFICIAL=1
            FWURL="$a"
        } || {
            error 2
        }
    }
done
}
[ $SETDIR -eq 1 ] && error 17
[ $AUTOUP -eq 1 -a $GETFW -eq 1 ] && error 2
[ $AUTOUP -eq 1 -a $ONLY  -eq 1 ] && error 2
#[ $AUTOUP -eq 1 ] && AUTOYES=1
[ $AUTOUP -eq 1 -o $GETFW -eq 1 ] && { [ "$FWURL" != "" ] && error 2 ; }
[ $AUTOUP -eq 1 -o $GETFW -eq 1 ] && { REMOTE=1 ; OFFICIAL=1 ; ISZIP=1 ; }
[ $AUTOUP -eq 0 -a $GETFW -eq 0 -a $ERASE -eq 0 -a "$FWURL" == "" ] && error 3
[ "$FWURL" != "" ] && {
    get_filename
    [ $REMOTE -eq 0 ] && { [ ! -s "$FWURL" ] && error 9 ; }
}
[ "$DLDIR" != "" ] && { case "$DLDIR" in ./) DLDIR="." ;; ../) DLDIR=".." ;; esac ; }
[ "$DLDIR"   != "" -a $REMOTE -eq 0 ] && error 21
[ "$NOCHECK" != "" -a $REMOTE -eq 0 ] && error 21
[ $FORCEZIP -eq 1 -o $FORCEFLY -eq 1 ] && [ $REMOTE -eq 0 ] && error 19
[ $FORCEZIP -eq 1 -o $FORCEFLY -eq 1 ] && [ $REMOTE -eq 1 -a $ISZIP -eq 0 ] && error 18
[ ! -d "$WORKDIR" -a $ERASE  -eq 0 ] && mkdir "$WORKDIR"
[ $ONLY -eq 1 ] && { [ "$MODE" != "" -o $RESTORE -eq 1 -o $AUTOYES -eq 1 ] && error 2 ; }
[ $ONLY -eq 1 -a $REMOTE -eq 0 ] && error 21
[ "$MODE"   == "" ] && { [ $RESTORE -eq 1 ] && MODE="clean" || MODE="dirty"; }
[ $RESTORE  -eq 1 ] && {
    [ $(mount | grep -q /mnt ; echo $?) -ne 0 ] && error 4
    NVBACKUP="$(which nvram_backup)"
    [ "$NVBACKUP" == "" ] && { [ -s "/tmp/nvram_backup" ] && NVBACKUP="/tmp/nvram_backup" || error 5 ; }
    AUTORUN="$(mount | grep /mnt | awk '{print $3}')/restore.autorun"
}


# Main
[ $ERASE -eq 1 ] && {
    printf "\n\n                POINT OF NO RETURN\n\n"
    printf "Erase all data in NVRAM memory (thorough)? $MSG"
    read ANSWER ; echo
    [ "$ANSWER" != "yes" ] && error 15
    { prepare_upgrade ; erase_nvram ; rboot ; } &
    wait
} || {
    [ $ONLY -eq 0 -a $(NG jffs2_on) -eq 1 ] && handle_jffs
    [ $GETFW -eq 1 -a "$GETFWARG" != "" ] && fw_get "$GETFWARG"
    [ $AUTOUP -eq 1 -o $GETFW -eq 1 ] && { [ "$GETFWARG" == "" ] && fw_get ; }
    [ $REMOTE -eq 1 ] && download
    [ $ONLY -eq 1 ] && exit 0
    prep_file
    printf "\n\n                POINT OF NO RETURN\n\n"
    printf "Make sure you are using the right firmware before proceeding!\n\n"
    printf "Current:\n"
    printf "   Router : $FULLMODEL\n"
    printf "   NVRAM  : $NVRAM\n"
    printf "   Version: $OSVER\n\n"
    printf "Upgrade with:\n"
    printf "   $fwname\n\n"
    [ $JFFS -eq 1 ] && printf "Warning: JFFS content might be lost, make sure to have backups!\n\n"
    [ "$MODE" == "clean" ] && printf "Warning: Clean upgrade mode selected.\nALL settings will be ERASED!\nClean upgrade is implied with option '-r'.\n\n"
    printf "Proceed $MODE upgrade?\n"
    [ $AUTOYES -eq 1 ] && {
        printf "\n\nTo cancel press CTRL+C\n\n"
        wait_loop 10 "Upgrade starting in"
    } || {
        printf "$MSG"
        read ANSWER ; echo
        [ "$ANSWER" != "yes" ] && error 15
    }
    ilog 6 "Starting $MODE upgrade with firmware '$fwname'"
    # starting upgrade in background to prevent disconnection incidents
    {
    [ $RESTORE -eq 1 ] && restore
    prepare_upgrade
    upgrade
    [ "$MODE" == "clean" ] && erase_nvram
    rboot
    } &
    wait
}
exit 0
